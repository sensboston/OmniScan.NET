<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OmniScan.Net.Ocr</RootNamespace>
  </PropertyGroup>

  <!--
    The text recognition of Windows (Windows.Media.Ocr) through a projection of only the namespaces it
    needs, made by C#/WinRT at build time: the whole Windows SDK projection would add 25 MB to the program.
  -->
  <PropertyGroup>
    <!-- An SDK that the build servers have (the API itself is in Windows 10 since 10240). -->
    <CsWinRTWindowsMetadata>10.0.26100.0</CsWinRTWindowsMetadata>
    <CsWinRTIncludes>Windows.Media.Ocr;Windows.Globalization.Language;Windows.Globalization.ILanguage;Windows.Globalization.LanguageLayoutDirection;Windows.Graphics.Imaging.SoftwareBitmap;Windows.Graphics.Imaging.ISoftwareBitmap;Windows.Graphics.Imaging.BitmapPixelFormat;Windows.Graphics.Imaging.BitmapAlphaMode;Windows.Graphics.Imaging.BitmapBuffer;Windows.Graphics.Imaging.IBitmapBuffer;Windows.Graphics.Imaging.BitmapBufferAccessMode;Windows.Graphics.Imaging.BitmapPlaneDescription;Windows.Graphics.Imaging.BitmapBounds;Windows.Graphics.DirectX;Windows.Foundation;Windows.Storage.Streams.IBuffer;Windows.Storage.Streams.Buffer</CsWinRTIncludes>
    <CsWinRTExcludes>Windows.Foundation.Diagnostics</CsWinRTExcludes>
    <!-- Generated code does not follow our nullability rules. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8765;CS8767;CS8604;CS8603;CS8625</WarningsNotAsErrors>
    <!-- The program runs on Windows 10 and later, where all of this is (since 10240). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <CsWinRTGenerateProjection>true</CsWinRTGenerateProjection>
    <!-- Its rewriting step looks for a separate .pdb; ours is embedded. -->
    <CsWinRTIIDOptimizerOptOut>true</CsWinRTIIDOptimizerOptOut>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniScan.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniScan.Net.Imaging\OmniScan.Net.Imaging.csproj" />
  </ItemGroup>

</Project>
