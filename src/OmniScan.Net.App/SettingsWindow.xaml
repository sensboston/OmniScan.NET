<Window x:Class="OmniScan.Net.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmniScan.Net.App"
        Title="{x:Static local:Strings.SettingsTitle}"
        Icon="pack://application:,,,/OmniScan;component/Assets/OmniScan.ico"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,16,0,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="KeyStatus" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Assist.State}" Value="Checking">
          <Setter Property="Opacity" Value="0.7" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Assist.State}" Value="Good">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Assist.State}" Value="Bad">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Assist.Status}" Value="">
          <Setter Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16,12,16,16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button MinWidth="96" Padding="12,6" IsDefault="True" Style="{DynamicResource AccentButtonStyle}"
              Content="{x:Static local:Strings.Ok}" Click="OnOk" />
      <Button MinWidth="96" Padding="12,6" Margin="8,0,0,0" IsCancel="True"
              Content="{x:Static local:Strings.Cancel}" />
    </StackPanel>
    <TabControl x:Name="Tabs">
      <TabItem Header="{x:Static local:Strings.TabGeneral}">
        <StackPanel x:Name="GeneralPage" Margin="4,0,4,8">
          <!-- Short tabs: the window is as tall as the longest one, so these get more air. -->
          <StackPanel.Resources>
            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
              <Setter Property="Margin" Value="0,26,0,8" />
            </Style>
          </StackPanel.Resources>
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static local:Strings.Language}" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding Language}"
                    SelectedValuePath="Value" DisplayMemberPath="Label" />
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static local:Strings.Theme}" />
          <ComboBox ItemsSource="{Binding Themes}" SelectedValue="{Binding Theme}"
                    SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="200" />
          <CheckBox Margin="0,24,0,0" IsChecked="{Binding CheckUpdates}" Content="{x:Static local:Strings.CheckUpdates}" />
          <CheckBox Margin="0,24,0,6" IsChecked="{Binding ServerEnabled}" IsEnabled="{Binding CanShare}">
            <TextBlock FontWeight="SemiBold" Text="{x:Static local:Strings.ServerMode}" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,0" Text="{x:Static local:Strings.ServerModeHint}" />
          <TextBlock Style="{StaticResource Hint}" Margin="28,6,0,0" FontStyle="Italic" Text="{x:Static local:Strings.ServerNoScanner}"
                     Visibility="{Binding CannotShare, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="{x:Static local:Strings.TabScanning}">
        <!-- The fullest tab: it sets the height of the window, so no extra air here. -->
        <StackPanel x:Name="ScanningPage" Margin="4,0,4,8">
          <!-- Where this scanner has the top of the page: two pictures to choose from. -->
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static local:Strings.ScannerTop}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasDevice}">
            <RadioButton GroupName="ScannerTop" IsChecked="{Binding TopOnLeft}" VerticalContentAlignment="Top">
              <StackPanel>
                <local:ScannerPicture TopOnRight="False" TopText="{x:Static local:Strings.TopWord}">
                  <local:ScannerPicture.LayoutTransform>
                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                  </local:ScannerPicture.LayoutTransform>
                </local:ScannerPicture>
                <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" Text="{x:Static local:Strings.TopLeft}" />
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="ScannerTop" Margin="24,0,0,0" IsChecked="{Binding Flip}" VerticalContentAlignment="Top">
              <StackPanel>
                <local:ScannerPicture TopOnRight="True" TopText="{x:Static local:Strings.TopWord}">
                  <local:ScannerPicture.LayoutTransform>
                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                  </local:ScannerPicture.LayoutTransform>
                </local:ScannerPicture>
                <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" Text="{x:Static local:Strings.TopRight}" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="{x:Static local:Strings.ScannerTopHint}" />
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static local:Strings.JpegQuality}" />
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" MinWidth="36" Margin="12,0,0,0" VerticalAlignment="Center"
                       TextAlignment="Right" Text="{Binding Value, ElementName=QualitySlider}" />
            <Slider x:Name="QualitySlider" Minimum="50" Maximum="100" TickFrequency="5" SmallChange="5" LargeChange="10"
                    IsSnapToTickEnabled="True" TickPlacement="BottomRight" VerticalAlignment="Center"
                    Value="{Binding JpegQuality}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{x:Static local:Strings.JpegQualityHint}" />
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static local:Strings.AutoContinue}" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding AutoContinueChoices}" SelectedValue="{Binding AutoContinueSeconds}"
                    SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="140" />
        </StackPanel>
      </TabItem>
      <TabItem Header="{x:Static local:Strings.TabAssist}">
        <StackPanel x:Name="AssistPage" Margin="4,0,4,8">
          <TextBlock Style="{StaticResource Caption}" Text="{x:Static local:Strings.AssistKey}" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,5" MinWidth="96"
                    Content="{x:Static local:Strings.AssistCheck}" IsEnabled="{Binding Assist.CanCheck}" Click="OnCheckKey" />
            <Grid VerticalAlignment="Center">
              <PasswordBox x:Name="KeyBox" PasswordChanged="OnKeyChanged" Padding="10,5,34,6" />
              <!-- Clears the key: shown while there is one. -->
              <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="7,2"
                      Content="&#x2715;" FontSize="11" Background="Transparent" BorderThickness="0" Cursor="Arrow"
                      ToolTip="{x:Static local:Strings.AssistClearKey}" Click="OnClearKey"
                      Visibility="{Binding Assist.HasKey, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </DockPanel>
          <TextBlock Style="{StaticResource KeyStatus}" Text="{Binding Assist.Status}" />
          <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{x:Static local:Strings.AssistKeyHint}" />

          <!-- What leaves the computer, and to whom: always in view, not in a tooltip. -->
          <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="4" BorderThickness="1"
                  Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                  BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
            <TextBlock TextWrapping="Wrap" Text="{Binding Assist.Warning}" />
          </Border>

          <TextBlock Style="{StaticResource Caption}" Text="{x:Static local:Strings.AssistUse}" />
          <StackPanel IsEnabled="{Binding Assist.Ready}">
            <CheckBox IsChecked="{Binding Assist.Orient}">
              <TextBlock Text="{x:Static local:Strings.AssistOrient}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox Margin="0,6,0,0" IsChecked="{Binding Assist.Describe}">
              <TextBlock Text="{x:Static local:Strings.AssistDescribe}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,0" Text="{x:Static local:Strings.AssistDescribeHint}" />
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
